RunService.RenderStepped:Connect(function()
frames = frames + 1
if os.clock() - lastTime >= 1 then
DockTitle.Text = "GLASS HUB  |  " .. frames .. " FPS"
frames = 0
lastTime = os.clock()
end
end)
