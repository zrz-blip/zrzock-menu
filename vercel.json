local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

if CoreGui:FindFirstChild("Template_CompactDock") then
    CoreGui.Template_CompactDock:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Template_CompactDock"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = CoreGui

local expanded = false

local Dock = Instance.new("Frame")
Dock.Size = UDim2.new(0, 290, 0, 42)
Dock.Position = UDim2.new(0.5, -145, 0, 14)
Dock.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
Dock.BorderSizePixel = 0
Dock.ClipsDescendants = true
Dock.Active = true
Dock.Draggable = true
Dock.Parent = ScreenGui
Instance.new("UICorner", Dock).CornerRadius = UDim.new(0, 21)

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(0, 230, 150)
Stroke.Thickness = 1.4
Stroke.Parent = Dock

local TopBar = Instance.new("Frame")
TopBar.Size = UDim2.new(1, 0, 0, 42)
TopBar.BackgroundTransparency = 1
TopBar.Parent = Dock

local StatusDot = Instance.new("Frame")
StatusDot.Size = UDim2.new(0, 8, 0, 8)
StatusDot.Position = UDim2.new(0, 16, 0.5, -4)
StatusDot.BackgroundColor3 = Color3.fromRGB(0, 230, 150)
StatusDot.Parent = TopBar
Instance.new("UICorner", StatusDot).CornerRadius = UDim.new(1, 0)

local InfoLabel = Instance.new("TextLabel")
InfoLabel.Size = UDim2.new(0, 160, 1, 0)
InfoLabel.Position = UDim2.new(0, 32, 0, 0)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = "ISLAND HUB | 60 FPS"
InfoLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
InfoLabel.Font = Enum.Font.GothamBold
InfoLabel.TextSize = 12
InfoLabel.TextXAlignment = Enum.TextXAlignment.Left
InfoLabel.Parent = TopBar

local ExpandBtn = Instance.new("TextButton")
ExpandBtn.Size = UDim2.new(0, 68, 0, 26)
ExpandBtn.Position = UDim2.new(1, -78, 0.5, -13)
ExpandBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 150)
ExpandBtn.Text = "OPEN"
ExpandBtn.TextColor3 = Color3.fromRGB(12, 12, 15)
ExpandBtn.Font = Enum.Font.GothamBold
ExpandBtn.TextSize = 11
ExpandBtn.Parent = TopBar
Instance.new("UICorner", ExpandBtn).CornerRadius = UDim.new(1, 0)

local Body = Instance.new("Frame")
Body.Size = UDim2.new(1, -24, 1, -54)
Body.Position = UDim2.new(0, 12, 0, 48)
Body.BackgroundTransparency = 1
Body.Parent = Dock
Instance.new("UIListLayout", Body).Padding = UDim.new(0, 8)

local function AddDockButton(text, callback)
    local active = false
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(24, 25, 30)
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(200, 205, 215)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Parent = Body
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text = text .. (active and ": ON" or ": OFF")
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = active and Color3.fromRGB(0, 230, 150) or Color3.fromRGB(24, 25, 30),
            TextColor3 = active and Color3.fromRGB(12, 12, 15) or Color3.fromRGB(200, 205, 215)
        }):Play()
        if callback then callback(active) end
    end)
end

AddDockButton("NPC Magnet", function(v) end)
AddDockButton("Kill Aura", function(v) end)
AddDockButton("Auto Rebirth", function(v) end)

ExpandBtn.MouseButton1Click:Connect(function()
    expanded = not expanded
    ExpandBtn.Text = expanded and "CLOSE" or "OPEN"
    TweenService:Create(Dock, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = expanded and UDim2.new(0, 320, 0, 200) or UDim2.new(0, 290, 0, 42),
        Position = expanded and UDim2.new(0.5, -160, 0, 14) or UDim2.new(0.5, -145, 0, 14)
    }):Play()
end)

local lastTime = os.clock()
local frames = 0
RunService.RenderStepped:Connect(function()
    frames = frames + 1
    if os.clock() - lastTime >= 1 then
        InfoLabel.Text = "ISLAND HUB | " .. frames .. " FPS"
        frames = 0
        lastTime = os.clock()
    end
end)

UserInputService.InputBegan:Connect(function(inp, gp)
    if not gp and inp.KeyCode == Enum.KeyCode.RightControl then
        Dock.Visible = not Dock.Visible
    end
end)
