local function AddToggle(page, text, default, callback)
    local state = default or false
    local holder = Instance.new("TextButton")
    holder.Size = UDim2.new(1, -8, 0, 42)
    holder.BackgroundColor3 = THEME.BgElem
    holder.BackgroundTransparency = 0.15
    holder.Text = "   " .. text
    holder.TextColor3 = THEME.TextMain
    holder.Font = Enum.Font.GothamSemibold
    holder.TextSize = 13
    holder.TextXAlignment = Enum.TextXAlignment.Left
    holder.AutoButtonColor = false
    holder.Parent = page
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)

    local hStroke = Instance.new("UIStroke")
    hStroke.Color = THEME.Stroke
    hStroke.Thickness = 1
    hStroke.Parent = holder

    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 42, 0, 22)
    pill.Position = UDim2.new(1, -52, 0.5, -11)
    pill.BackgroundColor3 = Color3.fromRGB(45, 42, 68)
    pill.Parent = holder
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = UDim2.new(0, 2, 0.5, -9)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.Parent = pill
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function updateVisual()
        TweenService:Create(pill, TweenInfo.new(0.15), {
            BackgroundColor3 = state and THEME.Accent or Color3.fromRGB(45, 42, 68),
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        }):Play()
        TweenService:Create(hStroke, TweenInfo.new(0.15), {
            Color = state and THEME.Accent or THEME.Stroke,
        }):Play()
    end
    updateVisual()

    holder.MouseButton1Click:Connect(function()
        state = not state
        updateVisual()
        if callback then callback(state) end
    end)
end

local function AddSlider(page, text, minVal, maxVal, defaultVal, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -8, 0, 54)
    frame.BackgroundColor3 = THEME.BgElem
    frame.BackgroundTransparency = 0.15
    frame.Parent = page
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

    local fStroke = Instance.new("UIStroke")
    fStroke.Color = THEME.Stroke
    fStroke.Thickness = 1
    fStroke.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 24)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = text .. ": " .. math.floor(defaultVal)
    lbl.TextColor3 = THEME.TextMain
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -20, 0, 8)
    bar.Position = UDim2.new(0, 10, 0, 34)
    bar.BackgroundColor3 = Color3.fromRGB(42, 38, 62)
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = frame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1), 0, 1, 0)
    fill.BackgroundColor3 = THEME.Accent
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, THEME.Accent2),
        ColorSequenceKeypoint.new(1, THEME.Accent),
    })
    gradient.Parent = fill

    local dragging = false
    local function update(input)
        local pct = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = math.floor(minVal + (maxVal - minVal) * pct)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        lbl.Text = text .. ": " .. val
        if callback then callback(val) end
    end

    bar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(inp)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then update(inp) end
    end)
end

