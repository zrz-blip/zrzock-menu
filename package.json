-- Рандомное имя, чтобы античит не нашёл по сигнатуре
local function randomString(len)
    local chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    local res = ""
    for _ = 1, len do
        local idx = math.random(1, #chars)
        res = res .. string.sub(chars, idx, idx)
    end
    return res
end

