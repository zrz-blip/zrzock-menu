local function ToggleDockState(forceState)
    if forceState ~= nil then isExpanded = forceState else isExpanded = not isExpanded end

    if isExpanded then
        ExpandBtn.Text = "HIDE"
        TweenService:Create(ExpandBtn, TweenInfo.new(0.2), {
            Position = UDim2.new(1, -110, 0.5, -14), BackgroundColor3 = THEME.BgElem,
        }):Play()
        CloseBtn.Visible = true
        BodyContainer.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 560, 0, 380),
            Position = UDim2.new(MainFrame.Position.X.Scale, MainFrame.Position.X.Offset - 110,
                                 MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset),
        }):Play()
        TweenService:Create(MainFrame:FindFirstChildOfClass("UICorner"), TweenInfo.new(0.25), {
            CornerRadius = UDim.new(0, 16),
        }):Play()
    else
        ExpandBtn.Text = "OPEN"
        TweenService:Create(ExpandBtn, TweenInfo.new(0.2), {
            Position = UDim2.new(1, -80, 0.5, -14), BackgroundColor3 = THEME.Accent,
        }):Play()
        CloseBtn.Visible = false
        local tw = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingStyle.In), {
            Size = UDim2.new(0, 340, 0, 46),
            Position = UDim2.new(MainFrame.Position.X.Scale, MainFrame.Position.X.Offset + 110,
                                 MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset),
        })
        tw:Play()
        TweenService:Create(MainFrame:FindFirstChildOfClass("UICorner"), TweenInfo.new(0.22), {
            CornerRadius = UDim.new(0, 24),
        }):Play()
        tw.Completed:Connect(function()
            if not isExpanded then BodyContainer.Visible = false end
        end)
    end
end

ExpandBtn.MouseButton1Click:Connect(function() ToggleDockState() end)

