local function AddDropdown(page, text, options, default, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -8, 0, 38)
    holder.BackgroundColor3 = THEME.BgElem
    holder.BackgroundTransparency = 0.15
    holder.Parent = page
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)

    local hStroke = Instance.new("UIStroke")
    hStroke.Color = THEME.Stroke
    hStroke.Thickness = 1
    hStroke.Parent = holder

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = holder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. (default or options[1])
    label.TextColor3 = THEME.TextMain
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 20, 1, 0)
    arrow.Position = UDim2.new(1, -25, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = THEME.TextSub
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 10
    arrow.Parent = holder

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, 0, 0, #options * 30)
    list.Position = UDim2.new(0, 0, 1, 4)
    list.BackgroundColor3 = THEME.BgSide
    list.BorderSizePixel = 0
    list.Visible = false
    list.Parent = holder
    Instance.new("UICorner", list).CornerRadius = UDim.new(0, 10)
    local listLayout = Instance.new("UIListLayout", list)
    listLayout.Padding = UDim.new(0, 2)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local isOpen = false
    btn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        list.Visible = isOpen
        arrow.Text = isOpen and "▲" or "▼"
        TweenService:Create(hStroke, TweenInfo.new(0.15), {
            Color = isOpen and THEME.Accent or THEME.Stroke,
        }):Play()
    end)

    for i, opt in ipairs(options) do
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, -6, 0, 28)
        row.BackgroundColor3 = THEME.BgElem
        row.BackgroundTransparency = 0.4
        row.Text = "  " .. opt
        row.TextColor3 = THEME.TextMain
        row.Font = Enum.Font.Gotham
        row.TextSize = 12
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.LayoutOrder = i
        row.Parent = list
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
        row.MouseEnter:Connect(function()
            TweenService:Create(row, TweenInfo.new(0.1), {BackgroundColor3 = THEME.BgHover}):Play()
        end)
        row.MouseLeave:Connect(function()
            TweenService:Create(row, TweenInfo.new(0.1), {BackgroundColor3 = THEME.BgElem}):Play()
        end)
        row.MouseButton1Click:Connect(function()
            label.Text = text .. ": " .. opt
            isOpen = false
            list.Visible = false
            arrow.Text = "▼"
            if callback then callback(opt) end
        end)
    end
end

local function AddTextBox(page, text, default, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -8, 0, 42)
    holder.BackgroundColor3 = THEME.BgElem
    holder.BackgroundTransparency = 0.15
    holder.Parent = page
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)

    local hStroke = Instance.new("UIStroke")
    hStroke.Color = THEME.Stroke
    hStroke.Thickness = 1
    hStroke.Parent = holder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 100, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text .. ":"
    label.TextColor3 = THEME.TextSub
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -120, 1, -8)
    box.Position = UDim2.new(0, 112, 0, 4)
    box.BackgroundColor3 = Color3.fromRGB(38, 34, 58)
    box.BackgroundTransparency = 0.3
    box.Text = default or ""
    box.PlaceholderText = "..."
    box.PlaceholderColor3 = THEME.TextSub
    box.TextColor3 = THEME.TextMain
    box.Font = Enum.Font.GothamSemibold
    box.TextSize = 12
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.ClearTextOnFocus = false
    box.Parent = holder
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 8)
    pad.Parent = box

    box.Focused:Connect(function()
        TweenService:Create(hStroke, TweenInfo.new(0.15), {Color = THEME.Accent}):Play()
    end)
    box.FocusLost:Connect(function()
        TweenService:Create(hStroke, TweenInfo.new(0.15), {Color = THEME.Stroke}):Play()
        if callback then callback(box.Text) end
    end)
end

local function AddKeybind(page, text, defaultKey, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -8, 0, 42)
    holder.BackgroundColor3 = THEME.BgElem
    holder.BackgroundTransparency = 0.15
    holder.Parent = page
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)

    local hStroke = Instance.new("UIStroke")
    hStroke.Color = THEME.Stroke
    hStroke.Thickness = 1
    hStroke.Parent = holder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -100, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = THEME.TextMain
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local keyBtn = Instance.new("TextButton")
    keyBtn.Size = UDim2.new(0, 80, 0, 28)
    keyBtn.Position = UDim2.new(1, -90, 0.5, -14)
    keyBtn.BackgroundColor3 = Color3.fromRGB(38, 34, 58)
    keyBtn.Text = tostring(defaultKey):gsub("Enum.KeyCode.", "")
    keyBtn.TextColor3 = THEME.AccentGlow
    keyBtn.Font = Enum.Font.GothamBold
    keyBtn.TextSize = 12
    keyBtn.AutoButtonColor = false
    keyBtn.Parent = holder
    Instance.new("UICorner", keyBtn).CornerRadius = UDim.new(0, 6)

    local currentKey = defaultKey
    local isListening = false

    keyBtn.MouseButton1Click:Connect(function()
        isListening = true
        keyBtn.Text = "..."
        keyBtn.TextColor3 = THEME.Accent
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp or not isListening then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            currentKey = input.KeyCode
            keyBtn.Text = tostring(currentKey):gsub("Enum.KeyCode.", "")
            keyBtn.TextColor3 = THEME.AccentGlow
            isListening = false
            if callback then callback(currentKey) end
        end
    end)
end

